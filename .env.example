# ===== Wallaby – configuration =====

# Public address of the app (used in email links and for the OIDC callback)
WALLABY_URL=https://wallaby.example.com

# Sign-up: "open" (anyone) or "closed" (only through an invitation link)
WALLABY_SIGNUP=open

# In production behind HTTPS: cookies only over secure connections
WALLABY_COOKIE_SECURE=1
# Set to 1 when a reverse proxy sits in front (nginx, Caddy, Traefik…)
WALLABY_PROXY=1

# Email (address confirmation and password recovery). Without SMTP the links are written to the log.
WALLABY_SMTP_HOST=
WALLABY_SMTP_PORT=587
WALLABY_SMTP_USER=
WALLABY_SMTP_PASSWORD=
WALLABY_MAIL_FROM=Wallaby <noreply@example.com>

# Sign-in with external providers (OpenID Connect), comma separated. Leave empty to disable.
# Callback URL to register with the provider: <WALLABY_URL>/api/oidc/<name>/callback
WALLABY_OIDC=
# Google (console.cloud.google.com → Credentials → OAuth client ID, "Web application")
WALLABY_OIDC_GOOGLE_ID=
WALLABY_OIDC_GOOGLE_SECRET=
# Any other OIDC provider, e.g. WALLABY_OIDC=google,microsoft
# WALLABY_OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# WALLABY_OIDC_MICROSOFT_ID=
# WALLABY_OIDC_MICROSOFT_SECRET=
# WALLABY_OIDC_MICROSOFT_NAME=Microsoft

# How many daily automatic database backups to keep
WALLABY_BACKUP_KEEP=30

# ----- Wombat: one sign-in and one family for all the family apps (optional) -----
# With these set, sign-in goes only through the OIDC provider (the same Pocket ID as Wombat) and the family, its
# members and people are managed in Wombat. Key: the same as WOMBAT_APP_WALLABY_KEY in Wombat.
WALLABY_HUB_URL=
WALLABY_HUB_KEY=
# Address of Wombat for people (links), if different from WALLABY_HUB_URL (e.g. an internal Docker address)
WALLABY_HUB_PUBLIC_URL=
